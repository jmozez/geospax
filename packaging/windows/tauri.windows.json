{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "publisher": "in4metrix",
    "copyright": "© in4metrix (www.in4metrix.dev) · developed by J. Moses · MIT",
    "category": "Utility",
    "shortDescription": "Maps that make themselves",
    "longDescription": "GeoSpaX: the open-source GIS where every map is a re-runnable recipe that triggers itself on new data.",
    "resources": {
      "../../../target/windows/runtime/": "./"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../../../packaging/windows/installer-hooks.nsh"
      }
    }
  }
}
