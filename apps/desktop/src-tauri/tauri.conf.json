{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoSpaX",
  "version": "3.0.4",
  "identifier": "org.geospax.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../web run build",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GeoSpaX",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "in4metrix",
    "copyright": "© in4metrix (www.in4metrix.dev) · MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NTVGN0U2NEIzOTlDNkQKUldSdG5EbEw1dmRWSnFSc054QnR2dlQ5d21tdnJoQVVRaTMxNjFoQjlUZE5IL0VKM2VzcitOY2cK",
      "endpoints": [
        "https://github.com/jmozez/geospax/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
